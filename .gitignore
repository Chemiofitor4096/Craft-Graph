# ---- Java / Gradle (mod) ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
logs/
run/
run-*/
*.log

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
bin/

# ---- Node / TypeScript (mcp-server) ----
node_modules/
dist/
*.tsbuildinfo
.npm/
npm-debug.log*

# 契约样本由 mod 的 ContractDumpTest 生成（gradlew test）。
# 不提交生成物：宁可要求先跑一次 Gradle，也不要让陈旧样本造成契约测试假通过。
shared/fixtures/bridge-dump/

# ---- CraftGraph 运行时产物 ----
# MCP Server 的本地配方缓存（体积可能很大，且随时可重建）
.cache/
*.cache.json
*.cache.sqlite

# 本地配置（可能含 token）
.env
.env.local
config.local.json

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本机维护脚本（不进版本库）----
#
# live-check.bat / release.bat 是维护者本机的便利脚本：双击跑真机体检、
# 或走一遍发布流程（推送 + tag + publish）。不进仓库的理由是它们绑定本机的
# 路径与凭据习惯，而真正的发布流程在 .github/workflows/release.yml 里有权威版本 ——
# 仓库里不需要第二份会过期的副本。
live-check.bat
release.bat

# AI 工具自己生成的忽略文件，不属于这个项目（工具会重新生成它）
.zcodeignore
